generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EARNER
  BUSINESS
  ADMIN
}

enum CampaignStatus {
  DRAFT
  LIVE
  PAUSED
  CLOSED
}

enum CampaignType {
  ORDER
  LEAD
  CONTENT
  REFERRAL
}

enum CommissionBasis {
  FIXED_ORDER
  PER_UNIT
  PERCENT_GMV
}

enum OrderStatus {
  SUBMITTED
  CUSTOMER_CONFIRMED
  ACCEPTED
  PAYMENT_PENDING
  PAID
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  VERIFIED
  PARTIALLY_DELIVERED
  DELIVERY_FAILED
  RETURN_IN_PROGRESS
  RETURNED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
  REFUND_PENDING
  REFUNDED
}
enum LogisticsStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNING
  RETURNED
}
enum SettlementStatus {
  HELD
  PAYABLE
  PAID
  REVERSED
}
enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum RewardStatus {
  PENDING
  EARNED
  PAYABLE
  PAID
  REVERSED
}

enum LedgerKind {
  REWARD_EARNED
  PAYOUT
  REWARD_REVERSAL
}

model User {
  id           String          @id @default(cuid())
  phone        String          @unique
  passwordHash String
  role         Role
  createdAt    DateTime        @default(now())
  business     Business?
  earner       EarnerProfile?
  orders       Order[]         @relation("EarnerOrders")
  ledger       LedgerEntry[]
}

model EarnerProfile {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id])
  displayName String
}

model Business {
  id        String     @id @default(cuid())
  ownerId   String     @unique
  owner     User       @relation(fields: [ownerId], references: [id])
  name      String
  verified  Boolean    @default(false)
  campaigns Campaign[]
  orders    Order[]
}

model Campaign {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id])
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  title       String
  city        String
  rewardPaisa BigInt
  commissionBasis CommissionBasis @default(FIXED_ORDER)
  unitLabel String?
  unitPricePaisa BigInt?
  businessCommissionPaisa BigInt?
  businessCommissionBps Int?
  earnerShareBps Int @default(10000)
  cap         Int
  successRule String
  createdAt   DateTime       @default(now())
  orders      Order[]
}

model Attribution {
  id         String   @id @default(cuid())
  code       String   @unique
  campaignId String
  earnerId   String
  createdAt  DateTime @default(now())

  @@unique([campaignId, earnerId])
}

model Order {
  id                String      @id @default(cuid())
  campaignId        String
  campaign          Campaign    @relation(fields: [campaignId], references: [id])
  businessId        String
  business          Business    @relation(fields: [businessId], references: [id])
  earnerId          String
  earner            User        @relation("EarnerOrders", fields: [earnerId], references: [id])
  attributionCode   String
  customerName      String
  customerPhoneHash String
  customerConfirmTokenHash String? @unique
  customerConfirmedAt DateTime?
  deliveryPinHash String?
  deliveryVerifiedAt DateTime?
  acceptedAt DateTime?
  paymentConfirmedAt DateTime?
  readyForPickupAt DateTime?
  pickedUpAt DateTime?
  deliveredAt DateTime?
  verifiedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?
  acceptedQuantity Int?
  pickedUpQuantity Int?
  deliveredQuantity Int?
  returnedQuantity Int @default(0)
  productSubtotalPaisaSnapshot BigInt?
  totalCommissionPaisaSnapshot BigInt?
  merchantSettlementPaisaSnapshot BigInt?
  deliveryFeePaisa BigInt @default(0)
  unitPricePaisaSnapshot BigInt?
  commissionBasisSnapshot CommissionBasis?
  businessCommissionPaisaSnapshot BigInt?
  businessCommissionBpsSnapshot Int?
  earnerShareBpsSnapshot Int?
  earnerRewardPaisaSnapshot BigInt?
  platformFeePaisaSnapshot BigInt?
  product           String
  quantity          Int
  status            OrderStatus @default(SUBMITTED)
  idempotencyKey    String      @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  reward            Reward?
  payment           Payment?
  logistics         LogisticsAssignment?
  settlements       Settlement[]
  disputes          Dispute[]
  events            OrderEvent[]

  @@index([businessId, status])
}

model Reward {
  id          String       @id @default(cuid())
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id])
  userId      String
  amountPaisa BigInt
  status      RewardStatus @default(EARNED)
  createdAt   DateTime     @default(now())
}

model LedgerEntry {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  kind           LedgerKind
  amountPaisa    BigInt
  referenceType  String
  referenceId    String
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId], references:[id])
  amountPaisa BigInt
  method String
  reference String?
  status PaymentStatus @default(PENDING)
  submittedAt DateTime?
  confirmedAt DateTime?
  refundedPaisa BigInt @default(0)
  createdAt DateTime @default(now())
}

model LogisticsAssignment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields:[orderId], references:[id])
  transporterName String
  transporterPhone String?
  quotedFeePaisa BigInt
  transporterCostPaisa BigInt
  status LogisticsStatus @default(ASSIGNED)
  pickupCodeHash String?
  assignedAt DateTime @default(now())
  pickedUpAt DateTime?
  deliveredAt DateTime?
  returnedAt DateTime?
}

model Settlement {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  partyType String
  partyId String?
  amountPaisa BigInt
  status SettlementStatus @default(HELD)
  paidAt DateTime?
  createdAt DateTime @default(now())
  @@unique([orderId,partyType])
}

model Dispute {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  openedBy String
  reason String
  details String?
  status DisputeStatus @default(OPEN)
  resolution String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([orderId,status])
}

model OrderEvent {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId], references:[id])
  type String
  actorRole String
  actorId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([orderId,createdAt])
}
