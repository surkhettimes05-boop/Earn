DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/earn?sslmode=require"
# Integration tests only. Must be a separate PostgreSQL database whose host or database name contains "test".
TEST_DATABASE_URL=
JWT_SECRET="replace-with-at-least-32-random-characters"

# Buyer payment instructions. Leave unused methods blank. Never commit real secrets/account details.
EARN_PAYMENT_ACCOUNT_NAME=
EARN_PAYMENT_REFERENCE_FORMAT="Use your order payment reference"
EARN_PAYMENT_BANK_NAME=
EARN_PAYMENT_BANK_ACCOUNT=
EARN_PAYMENT_ESEWA_ID=
EARN_PAYMENT_KHALTI_ID=
